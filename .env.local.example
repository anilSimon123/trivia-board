# Copy this file to .env.local (for dev) or set these vars in Vercel.
# All values are OPTIONAL — the app runs out of the box using a local JSON file
# and an open admin page. Set them for production.

# ----- Admin password (recommended in production) -----
# When unset, /admin is open. When set, /admin/login requires this password.
ADMIN_PASSWORD=

# ----- Supabase (recommended in production) -----
# When both are unset, the board is stored in ./.data/board.json on the server
# filesystem. This works fine locally but does NOT persist on Vercel between
# deploys (their filesystem is read-only in production).
#
# In the Supabase dashboard, the value labelled "secret key" (new naming) is
# the same thing as the older "service_role key". Either env var name below
# works — pick whichever matches what you see in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
